# Copy this file to ".env" and fill in your own values.

# Port the API listens on
PORT=5000

# MongoDB connection string
#   Local MongoDB:  mongodb://127.0.0.1:27017/shopez
#   MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shopez?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/shopez

# Secret used to sign login tokens (use a long random string)
JWT_SECRET=change_this_to_a_long_random_secret

# How long a login token stays valid
JWT_EXPIRES_IN=7d

# Address of the React app (allowed by CORS)
CLIENT_URL=http://localhost:5173
